# Environment for Node scripts — NOT for the running app.
#
# The app reads its configuration from Cloudflare Worker bindings, which come
# from `.dev.vars` in local dev. See `.dev.vars.example`. A `.env` file does
# not reach the Worker.
#
# This file is for the offline tooling that runs in plain Node, chiefly:
#   pnpm eval:extraction     (scores profile extraction per language)
#
# You usually do NOT need this file: the tooling reads `.dev.vars` first, so a
# single `.dev.vars` serves both the app and the scripts. Use `.env` only when
# you want the scripts pointed at a different provider than the app.

# Chat provider. Either set works; LLM_* wins when both are present.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Local Worker: use ignored .dev.vars. Production: encrypted Cloudflare secret.
# API key needs Text to Speech + Speech to Text access. Never commit its value.
ELEVENLABS_API_KEY=
# Optional voice ID. Models are fixed in code: eleven_v3 and scribe_v2.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional separately deployed Python service; HTTPS and matching release required.
RULE_SERVICE_URL=
RULE_SERVICE_API_KEY=
# Python service environment:
SERVICE_API_KEY=
DATABASE_URL=
STORAGE_MODE=postgres
# Web storage: d1 preserves the D1-only deployment; dual mirrors to PostgreSQL.
DATA_STORAGE_MODE=d1
POSTGRES_SERVICE_URL=
POSTGRES_SERVICE_API_KEY=
# Authenticates the private /api/v1/storage/sync retry endpoint.
STORAGE_SYNC_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
YOU_API_KEY=
# mem0 is an experimental preference adapter, not activated in the hosted app.
MEM0_API_KEY=
POSTGRES_PASSWORD=

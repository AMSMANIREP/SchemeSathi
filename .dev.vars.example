# Local development secrets for the Worker.
#
# Copy this to `.dev.vars` (NOT `.env`) and restart the dev server.
#
# The app reads configuration from Cloudflare Worker bindings via
# `import { env } from 'cloudflare:workers'`, and the Cloudflare Vite plugin
# populates those from `.dev.vars` in local dev. A `.env` file does NOT reach
# the app: the plugin only reads CLOUDFLARE_-prefixed variables from it.
#
# For a deployed Worker these are secrets, not files:
#   wrangler secret put LLM_API_KEY --config wrangler.cloudflare.jsonc

# --- Chat provider. Either set works; LLM_* wins when both are present. ---
# LLM_* accepts any OpenAI-compatible endpoint (Nebius, Together, Groq,
# OpenRouter, a local server). Base URL with or without /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Azure OpenAI, still supported for existing deployments.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# --- Voice. Both are required before voice appears in the interface. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Optional ---
# Separately deployed Python parity service; disagreement forces abstention.
RULE_SERVICE_URL=
RULE_SERVICE_API_KEY=
# Guards the /admin/reviews endpoint.
REVIEWER_TOKEN=
